#!/usr/bin/env bash
set -euo pipefail

license_url="https://go.microsoft.com/fwlink/?LinkId=2086102"
root="${MSVC_ROOT:-$HOME/.msvc}"
tools="${MSVC_WINE_TOOLS:-/opt/msvc-wine}"
tmpdir="$HOME/.cache/msvc-setup-tmp"
min_free_kb=12582912  # 12 GiB: ca. 9 GiB Installation + Download-/Entpackreserve

if [[ "${1:-}" != "--accept-license" ]]; then
  cat >&2 <<EOF
MSVC und Windows SDK sind nicht redistribuierbar und nicht im Image enthalten.
Lies und akzeptiere zuerst die Microsoft-Lizenz:
  $license_url

Danach einmalig ausfuehren:
  msvc-setup --accept-license
EOF
  exit 64
fi

mkdir -p "$HOME"
exec 9>"$HOME/.msvc-setup.lock"
flock 9

if [[ -f "$root/.synapse-msvc-ready" ]]; then
  echo "MSVC/Windows SDK bereits eingerichtet: $root"
  exit 0
fi

mkdir -p "$tmpdir"
free_kb="$(df -Pk "$HOME" | awk 'NR == 2 { print $4 }')"
if [[ ! "$free_kb" =~ ^[0-9]+$ ]] || (( free_kb < min_free_kb )); then
  rm -rf "$tmpdir"
  echo "Zu wenig freier Platz im Workspace-HOME: mindestens 12 GiB erforderlich." >&2
  exit 70
fi
export TMPDIR="$tmpdir"

partial="$root.partial"
rm -rf "$partial"
mkdir -p "$partial"
trap 'rm -rf "$partial" "$tmpdir"' EXIT

python3 "$tools/vsdownload.py" --accept-license --dest "$partial"
"$tools/install.sh" "$partial"
touch "$partial/.synapse-msvc-ready"

rm -rf "$root"
mv "$partial" "$root"
rm -rf "$tmpdir"
trap - EXIT

echo "MSVC/Windows SDK eingerichtet: $root"
echo "Naechster Schritt: msvc-smoke"
